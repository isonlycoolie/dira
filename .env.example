# Core services
# type: PostgreSQL connection string
DATABASE_URL=

# type: Redis connection string
REDIS_URL=

# type: comma-separated Kafka broker addresses
KAFKA_BROKERS=

# type: logging level string
LOG_LEVEL=INFO

# type: environment name (dev|prod)
ENV=dev

# Geospatial and data
# type: Dar es Salaam bounding box (lat_min,lon_min,lat_max,lon_max)
DSM_BBOX=

# type: road buffer distance in meters
ROAD_BUFFER_METERS=50

# type: Google Cloud Storage bucket prefix
GCS_BUCKET_PREFIX=

# Pipeline and compute
# type: Apache Spark master URL
SPARK_MASTER_URL=

# type: Airflow metadata database connection string
AIRFLOW_DB_URL=

# External APIs
# type: OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=

# Optional / dev-only
# type: PostgreSQL password used by local containers
POSTGRES_PASSWORD=

# type: Airflow home directory path
AIRFLOW_HOME=

# type: Docker Compose flag for Kafka topic auto creation
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
